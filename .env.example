# Signalpost Atlas — Environment Variables Template
# Copy this file to .env and insert authorized credentials.
# Do NOT commit .env or API keys to version control.

# Optional: Brave Search API Key for Missing Website Discovery
# If omitted, Signalpost Atlas falls back to deterministic heuristic domain discovery
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# Concurrency and Watchdog Tuning (Defaults shown)
SIGNALPOST_WORKERS=6
SIGNALPOST_TIMEOUT_SECONDS=2700
SIGNALPOST_MAX_REQUESTS=2000
